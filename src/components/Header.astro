---
import { navKeys, href } from "../lib/data";
import { getLangFromUrl, swapLangUrl, type Lang } from "../lib/i18n";
import { getCompany, getPage, pick, imageUrl } from "../lib/sanity";

interface Props {
  lang?: Lang;
}

const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const company = await getCompany();
const nav = await getPage("nav");
const enUrl = swapLangUrl(Astro.url.pathname, "en");
const ptUrl = swapLangUrl(Astro.url.pathname, "pt");
const path = Astro.url.pathname;
const homeHref = lang === "pt" ? "/pt/" : "/";
const whatsappLabel = pick(nav, "whatsapp", lang);
const logoSrc = imageUrl(company.logo) ?? "/uploads/brand/sterna-experiences-full.png";
---

<header class="site-header">
  <div class="container header-inner">
    <a href={homeHref} class="brand" aria-label={`${company.name} · home`}>
      <img src={logoSrc} alt={company.name} class="brand-logo" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {navKeys.map((link) => {
          const linkHref = href(link, lang);
          const isCurrent = path === linkHref || (linkHref !== homeHref && path.startsWith(linkHref));
          return (
            <li>
              <a href={linkHref} aria-current={isCurrent ? "page" : undefined}>
                {pick(nav, link.key, lang)}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-cta">
      <div class="lang-toggle" role="group" aria-label="Language">
        <span class="lang-globe" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
          </svg>
        </span>
        <a href={enUrl} class:list={["lang-opt", { "is-active": lang === "en" }]} aria-current={lang === "en" ? "page" : undefined}>EN</a>
        <span class="lang-sep" aria-hidden="true">·</span>
        <a href={ptUrl} class:list={["lang-opt", { "is-active": lang === "pt" }]} aria-current={lang === "pt" ? "page" : undefined}>PT</a>
      </div>
      <a href={company.whatsappHref} class="whatsapp-link btn btn-primary" target="_blank" rel="noopener" aria-label={`WhatsApp ${company.whatsapp}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.52 3.449C12.831-3.984.106 1.407.101 11.893c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a11.882 11.882 0 005.688 1.448h.005c9.436 0 14.833-9.877 10.492-17.855-.708-1.303-1.775-2.427-3-3.492zM12.028 21.786a9.82 9.82 0 01-5.011-1.371l-.36-.214-3.723.976 1.001-3.639-.235-.376A9.822 9.822 0 012.24 12.05c0-5.407 4.4-9.807 9.807-9.807 2.62 0 5.081 1.02 6.937 2.876a9.746 9.746 0 012.868 6.943c-.005 5.407-4.404 9.807-9.824 9.807z"/>
        </svg>
        {whatsappLabel}
      </a>
    </div>

    <button
      class="burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {navKeys.map((link) => (
          <li>
            <a href={href(link, lang)}>
              {pick(nav, link.key, lang)}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-cta">
        <div class="lang-toggle lang-toggle-mobile" role="group" aria-label="Language">
          <span class="lang-globe" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9"/>
              <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
            </svg>
          </span>
          <a href={enUrl} class:list={["lang-opt", { "is-active": lang === "en" }]} aria-current={lang === "en" ? "page" : undefined}>EN</a>
          <span class="lang-sep" aria-hidden="true">·</span>
          <a href={ptUrl} class:list={["lang-opt", { "is-active": lang === "pt" }]} aria-current={lang === "pt" ? "page" : undefined}>PT</a>
        </div>
        <a href={company.whatsappHref} target="_blank" rel="noopener" class="btn btn-primary">WhatsApp · {company.whatsapp}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(245, 239, 228, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    min-height: 128px;
    padding-block: 0.6rem;
  }
  .brand { justify-self: start; }
  .primary-nav { justify-self: center; }
  .header-cta { justify-self: end; }

  .brand { display: inline-flex; align-items: center; text-decoration: none; color: var(--teal-900); }
  .brand-logo {
    height: 112px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  @media (max-width: 640px) {
    .header-inner { min-height: 96px; padding-block: 0.4rem; }
    .brand-logo { height: 78px; }
  }

  .primary-nav ul { display: flex; gap: 0.125rem; list-style: none; }
  .primary-nav a {
    display: inline-block;
    padding: 0.625rem 0.95rem;
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--ink-soft);
    border-radius: var(--radius-pill);
    transition: color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .primary-nav a:hover { color: var(--teal-900); background: var(--teal-50); }
  .primary-nav a[aria-current="page"] { color: var(--teal-900); background: var(--teal-50); }

  .header-cta { display: flex; align-items: center; gap: 0.75rem; }
  .header-cta .btn-primary { padding: 0.6rem 1.1rem; font-size: 0.85rem; }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--ink-mute);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    letter-spacing: 0.05em;
    transition: border-color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .lang-toggle:hover { border-color: var(--teal-800); background: var(--teal-50); }
  .lang-globe { display: inline-flex; width: 16px; height: 16px; }
  .lang-globe svg { width: 100%; height: 100%; }
  .lang-opt {
    color: var(--ink-mute);
    padding: 0 0.15rem;
    transition: color var(--dur-base) var(--ease-out);
  }
  .lang-opt:hover { color: var(--teal-900); }
  .lang-opt.is-active {
    color: var(--teal-900);
    font-weight: 700;
    pointer-events: none;
  }
  .lang-sep { color: var(--ink-mute); opacity: 0.5; }

  .whatsapp-link { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 600; font-size: var(--text-body-sm); color: var(--ink); transition: color var(--dur-base) var(--ease-out); }
  .whatsapp-link svg { color: #25d366; }
  .whatsapp-link:hover { color: var(--teal-800); }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    justify-self: end;
  }
  .burger span { width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu { background: var(--paper); border-top: 1px solid var(--line); }
  .mobile-menu nav { padding: var(--gutter); max-width: var(--container-max); margin-inline: auto; }
  .mobile-menu ul { list-style: none; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .mobile-menu ul a { display: block; padding: 0.875rem 0.75rem; font-family: var(--font-display); font-size: var(--text-body-lg); color: var(--ink); border-bottom: 1px solid var(--line); }
  .mobile-cta { display: flex; flex-direction: column; gap: 0.75rem; }
  .mobile-cta .btn { justify-content: center; }
  .lang-toggle-mobile { justify-content: center; align-self: center; }

  @media (max-width: 1040px) {
    .header-inner { grid-template-columns: 1fr auto; }
    .primary-nav, .header-cta { display: none; }
    .burger { display: inline-flex; }
  }
  @media (min-width: 1041px) {
    .mobile-menu { display: none !important; }
  }
</style>

<script>
  function initMobileMenu() {
    const burger = document.querySelector<HTMLButtonElement>(".burger");
    const menu = document.querySelector<HTMLElement>("#mobile-menu");
    if (!burger || !menu) return;

    function toggle(open: boolean) {
      if (!burger || !menu) return;
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
      document.body.style.overflow = open ? "hidden" : "";
    }

    burger.addEventListener("click", () => {
      const open = burger.getAttribute("aria-expanded") === "true";
      toggle(!open);
    });

    menu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => toggle(false));
    });
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
  document.addEventListener("astro:before-swap", () => {
    document.body.style.overflow = "";
  });
</script>
