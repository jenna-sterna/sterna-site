---
import { navKeys, href, path } from "../lib/data";
import { loadFeaturedExperiences } from "../lib/experiences";
import { getLangFromUrl, type Lang } from "../lib/i18n";
import { getCompany, getPage, pick } from "../lib/siteData";

interface Props { lang?: Lang; }
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const company = await getCompany();
const footer = await getPage("footer");
const nav = await getPage("nav");
const year = new Date().getFullYear();
const featured = (await loadFeaturedExperiences()).slice(0, 6);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="foot-brand">
      <a href={lang === "pt" ? "/pt/" : "/"} class="foot-word">Sterna <span>Aveiro Experiences</span></a>
      <p class="foot-tag">{pick(footer, "tagline", lang)}</p>
      <div class="foot-badges">
        <span class="chip">{pick(footer, "chip1", lang)}</span>
        <span class="chip">{pick(footer, "chip2", lang)}</span>
        <span class="chip">{pick(footer, "chip3", lang)}</span>
      </div>
    </div>

    <div class="foot-col">
      <h5>{pick(footer, "colExplore", lang)}</h5>
      <ul>
        {navKeys.map((link) => (
          <li><a href={href(link, lang)}>{pick(nav, link.key, lang)}</a></li>
        ))}
      </ul>
    </div>

    <div class="foot-col">
      <h5>{pick(footer, "colExperiences", lang)}</h5>
      <ul>
        {featured.map((e) => (
          <li><a href={path(`/experiences/${e.slug}/`, lang)}>{e.short[lang]}</a></li>
        ))}
      </ul>
    </div>

    <div class="foot-col foot-contact">
      <h5>{pick(footer, "colContact", lang)}</h5>
      <ul>
        <li><a href={company.whatsappHref} target="_blank" rel="noopener">WhatsApp {company.whatsapp}</a></li>
        <li><a href={company.emailHref}>{company.email}</a></li>
        <li><a href={company.instagramUrl} target="_blank" rel="noopener">Instagram {company.instagramHandle}</a></li>
        <li><a href={company.tripadvisorUrl} target="_blank" rel="noopener">TripAdvisor · {pick(footer, "tripadvisorLinkText", lang)}</a></li>
      </ul>
    </div>
  </div>

  <div class="container foot-bottom">
    <p>{pick(footer, "rightsPrefix", lang)} {year} {company.name}. {pick(footer, "rightsSuffix", lang)}</p>
    <p class="obrigado">{pick(footer, "obrigado", lang)}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal-900);
    color: rgba(245, 239, 228, 0.85);
    padding-block: 5rem 2rem;
    margin-top: var(--section-y-lg);
  }
  .site-footer h5 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--shell);
    margin-bottom: 1rem;
  }
  .site-footer ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .site-footer a {
    color: rgba(245, 239, 228, 0.75);
    font-size: var(--text-body-sm);
    transition: color var(--dur-base) var(--ease-out);
  }
  .site-footer a:hover { color: var(--ochre-500); }

  .footer-grid { display: grid; grid-template-columns: 1.4fr 0.7fr 0.9fr 1.1fr; gap: 3rem; }

  .foot-brand .foot-word {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    color: var(--shell);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .foot-brand .foot-word span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(245, 239, 228, 0.55);
    margin-top: 0.35rem;
  }
  .foot-tag { margin-top: 1rem; color: rgba(245, 239, 228, 0.7); font-size: 0.95rem; max-width: 24ch; }
  .foot-badges { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .foot-badges .chip { background: rgba(245, 239, 228, 0.08); border-color: rgba(245, 239, 228, 0.15); color: rgba(245, 239, 228, 0.85); }

  .foot-bottom {
    margin-top: 4rem; padding-top: 2rem;
    border-top: 1px solid rgba(245, 239, 228, 0.12);
    display: flex; justify-content: space-between; gap: 1rem;
    font-size: 0.85rem; color: rgba(245, 239, 228, 0.6);
  }
  .obrigado { font-family: var(--font-hand); color: var(--ochre-500); font-size: 1.15rem; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
    .foot-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
