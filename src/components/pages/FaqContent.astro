---
import Layout from "../../layouts/Layout.astro";
import { company } from "../../lib/data";
import { getT, type Lang } from "../../lib/i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getT(lang);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: t.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout lang={lang} title={`${t.faq.eyebrow} · ${company.name}`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero">
    <div class="container">
      <p class="page-eyebrow">{t.faq.eyebrow}</p>
      <h1 class="page-h1">
        <span class="mask-line" data-stagger-index="0"><span>{t.faq.h1Line1}</span></span>
        <span class="mask-line hero-italic" data-stagger-index="1"><span>{t.faq.h1Line2}</span></span>
      </h1>
      <p class="page-lead reveal" data-stagger-index="2">{t.faq.lead}</p>
    </div>
  </section>

  <section class="faq-section">
    <div class="container-narrow">
      <ul class="faq-list" data-reveal-group>
        {t.faqs.map((f, i) => (
          <li class="faq-item reveal" data-stagger-index={i}>
            <details>
              <summary>
                <span>{f.q}</span>
                <span class="chev" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
                </span>
              </summary>
              <div class="answer">
                <p>{f.a}</p>
              </div>
            </details>
          </li>
        ))}
      </ul>

      <div class="faq-cta reveal">
        <span class="hand">{t.faq.stillCurious}</span>
        <div class="faq-cta-btns">
          <a href={company.whatsappHref} target="_blank" rel="noopener" class="btn btn-primary">{t.faq.whatsappCta}</a>
          <a href={company.emailHref} class="btn btn-ghost">{t.faq.emailCta}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(4rem, 10vw, 7rem) clamp(3rem, 6vw, 4.5rem); background: var(--shell); border-bottom: 1px solid var(--line); }
  .page-eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: var(--teal-800); margin-bottom: 1.25rem; }
  .page-h1 { font-size: var(--text-display); line-height: 1.02; margin-bottom: 2rem; }
  .page-h1 .mask-line { display: block; }
  .hero-italic { font-style: italic; color: var(--ochre-800); font-variation-settings: "opsz" 144; }
  .page-lead { max-width: 62ch; font-size: var(--text-lead); color: var(--ink-soft); }

  .faq-section { padding-block: var(--section-y-lg); }
  .faq-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item details { border-bottom: 1px solid var(--line); padding-block: 1.5rem; transition: background var(--dur-base) var(--ease-out); }
  .faq-item summary {
    display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;
    cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 500;
    color: var(--ink); line-height: 1.35; letter-spacing: -0.005em;
    transition: color var(--dur-base) var(--ease-out);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--teal-800); }
  .faq-item .chev {
    display: inline-flex; width: 32px; height: 32px;
    border-radius: 50%; background: var(--paper-warm); color: var(--teal-800);
    align-items: center; justify-content: center; flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .faq-item .chev svg { width: 16px; height: 16px; }
  .faq-item details[open] .chev { transform: rotate(180deg); background: var(--teal-800); color: var(--shell); }
  .faq-item .answer { padding-top: 1rem; max-width: 62ch; }
  .faq-item .answer p { color: var(--ink-soft); line-height: 1.65; }

  .faq-cta { margin-top: 4rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .faq-cta .hand { font-size: 1.75rem; color: var(--ochre-800); }
  .faq-cta-btns { display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: center; }
</style>
