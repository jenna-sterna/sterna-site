---
import Layout from "../../layouts/Layout.astro";
import { path } from "../../lib/data";
import type { Lang } from "../../lib/i18n";
import { getCompany, getFounders, getPage, pick } from "../../lib/siteData";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const about = await getPage("about");
const home = await getPage("home"); // for shared CTA copy
const company = await getCompany();
const founders = await getFounders();

const bussacoImg = "/uploads/walking-tour/20260711_120135.jpg";
const boatImg = "/uploads/boat-tour/20260704_204620~2.jpg";
const storyPara1 = pick(about, "storyPara1", lang);
---

<Layout lang={lang} title={`${pick(about, "eyebrow", lang)} · ${company.name}`}>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <p class="page-eyebrow">{pick(about, "eyebrow", lang)}</p>
      <h1 class="page-h1">
        <span class="mask-line" data-stagger-index="0"><span>{pick(about, "h1Line1", lang)}</span></span>
        <span class="mask-line hero-italic" data-stagger-index="1"><span>{pick(about, "h1Line2", lang)}</span></span>
      </h1>
      <p class="page-lead reveal" data-stagger-index="2">{pick(about, "lead", lang)}</p>
    </div>
  </section>

  <!-- Story (magazine, drop cap, no values quad) -->
  <section class="story">
    <div class="container story-grid">
      <div class="story-body">
        <div class="section-marker">
          <span class="marker-num">01</span>
          <span class="marker-line"></span>
          <span class="marker-label">{pick(about, "storyH2", lang)}</span>
        </div>

        <p class="story-para story-para-lead">
          <span class="dropcap">{storyPara1.charAt(0)}</span>{storyPara1.slice(1)}
        </p>
        <p class="story-para reveal">{pick(about, "storyPara2", lang)}</p>
        <p class="story-para reveal">{pick(about, "storyPara3", lang)}</p>
        <p class="story-para reveal">{pick(about, "storyPara4", lang)}</p>
        <p class="story-sig reveal">{pick(about, "storySig", lang)}</p>
      </div>

      <div class="story-media">
        <div class="photo-reveal story-photo">
          <img src={bussacoImg} alt="Bussaco Palace" loading="lazy" />
        </div>
        <div class="story-annotation" aria-hidden="true">
          <svg viewBox="0 0 60 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path d="M55 32 C 40 22, 25 17, 8 6"/>
            <path d="M12 12 L 8 6 L 16 4" fill="none"/>
          </svg>
          <span class="hand">{lang === "pt" ? "Buçaco em Maio" : "Bussaco in May"}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Founders (single grid, primary place for cards) -->
  <section class="founders">
    <div class="container">
      <div class="section-marker">
        <span class="marker-num">02</span>
        <span class="marker-line"></span>
        <span class="marker-label">{pick(about, "meetH2", lang)}</span>
      </div>

      <div class="founders-grid" data-reveal-group>
        {founders.map((f, i) => (
          <article class="founder-card" data-stagger-index={i}>
            <div class="founder-avatar photo-reveal">
              {f.photo ? (
                <img src={f.photo} alt={f.name} loading="lazy" />
              ) : (
                <div class="avatar-placeholder">
                  <span class="hand">{f.name}</span>
                </div>
              )}
            </div>
            <h3>{f.name}</h3>
            <p class="founder-role">{f.role[lang]}</p>
            <p class="founder-origin">{f.origin[lang]}</p>
            <p class="founder-line">{f.line[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Aveiro (long-form, no bullet list) -->
  <section class="why">
    <div class="container why-grid">
      <div class="why-media">
        <div class="photo-reveal">
          <img src={boatImg} alt="Aveiro lagoon at sunset" loading="lazy" />
        </div>
      </div>
      <div class="why-body">
        <div class="section-marker">
          <span class="marker-num">03</span>
          <span class="marker-line"></span>
          <span class="marker-label">{pick(about, "whyEyebrow", lang)}</span>
        </div>
        <h2 class="why-h2">
          <span class="mask-line"><span>{pick(about, "whyH2Line1", lang)}</span></span>
          <span class="mask-line why-h2-emph"><span>{pick(about, "whyH2Line2", lang)}</span></span>
        </h2>
        <p class="why-lead reveal">{pick(about, "whyLead", lang)}</p>
        <p class="why-body-text reveal">{pick(about, "whyBody", lang)}</p>
      </div>
    </div>
  </section>

  <!-- Simple CTA -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div class="cta-copy">
        <h2 class="cta-h2">{pick(home, "cta_h2", lang)}</h2>
        <p class="cta-lead">{pick(home, "cta_lead", lang)} <span class="hand">{pick(home, "cta_obrigado", lang)}</span></p>
      </div>
      <div class="cta-actions">
        <a href={company.whatsappHref} target="_blank" rel="noopener" class="btn btn-ochre btn-lg">
          {pick(home, "cta_whatsapp", lang)} {company.whatsapp}
        </a>
        <a href={company.emailHref} class="btn btn-ghost btn-lg cta-ghost">{pick(home, "cta_email", lang)}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(4rem, 10vw, 7rem) clamp(3rem, 6vw, 4.5rem); background: var(--shell); border-bottom: 1px solid var(--line); }
  .page-eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: var(--teal-800); margin-bottom: 1.25rem; }
  .page-h1 { font-size: var(--text-display); line-height: 1.02; margin-bottom: 2rem; }
  .page-h1 .mask-line { display: block; }
  .hero-italic { font-style: italic; color: var(--ochre-800); font-variation-settings: "opsz" 144; }
  .page-lead { max-width: 62ch; font-size: var(--text-lead); color: var(--ink-soft); }

  .section-marker { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 2rem; }
  .marker-num { font-family: var(--font-display); font-weight: 500; font-size: 1.05rem; color: var(--ochre-800); }
  .marker-line { display: inline-block; width: 48px; height: 1px; background: var(--line-strong); }
  .marker-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-mute); }

  /* Story */
  .story { padding-block: var(--section-y-lg); }
  .story-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: start; }
  .story-para { margin-bottom: 1.25rem; color: var(--ink-soft); line-height: 1.7; }
  .story-para-lead { font-family: var(--font-display); font-size: clamp(1.15rem, 1.5vw, 1.35rem); color: var(--ink); line-height: 1.5; }
  .dropcap { float: left; font-family: var(--font-display); font-weight: 500; font-size: 4.5em; line-height: 0.9; padding: 0.05em 0.12em 0 0; color: var(--ochre-800); font-variation-settings: "opsz" 144; }
  .story-sig { font-family: var(--font-hand); font-size: 1.75rem; color: var(--ochre-800); margin-top: 1.5rem !important; }
  .story-media { position: relative; }
  .story-photo { aspect-ratio: 4/5; }
  .story-photo :global(img), .story-photo img { width: 100%; height: 100%; object-fit: cover; }
  .story-annotation { position: absolute; top: -1rem; right: -1rem; color: var(--ochre-800); display: flex; flex-direction: column; align-items: flex-end; transform: rotate(4deg); }
  .story-annotation svg { width: 60px; height: 40px; }
  .story-annotation .hand { font-size: 1.2rem; margin-top: 0.35rem; }
  @media (max-width: 900px) { .story-grid { grid-template-columns: 1fr; gap: 3rem; } }

  /* Founders */
  .founders { padding-block: var(--section-y-lg); background: var(--shell); border-block: 1px solid var(--line); }
  .founders-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .founder-card { display: flex; flex-direction: column; gap: 0.6rem; }
  .founder-avatar { aspect-ratio: 4/5; margin-bottom: 0.5rem; overflow: hidden; border-radius: 6px; background: var(--paper-warm); }
  .founder-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; display: block; }
  .avatar-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--teal-100), var(--ochre-100)); display: flex; align-items: center; justify-content: center; color: var(--ink-mute); font-size: 2.25rem; }
  .founder-card h3 { margin-top: 0.75rem; }
  .founder-role { font-size: 0.85rem; font-weight: 600; color: var(--teal-800); text-transform: uppercase; letter-spacing: 0.08em; }
  .founder-origin { font-family: var(--font-hand); font-size: 1.25rem; color: var(--ochre-800); }
  .founder-line { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; margin-top: 0.5rem; }
  @media (max-width: 780px) { .founders-grid { grid-template-columns: 1fr; gap: 3rem; } }

  /* Why */
  .why { padding-block: var(--section-y-lg); }
  .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .why-media .photo-reveal { aspect-ratio: 4/5; }
  .why-media :global(img), .why-media img { width: 100%; height: 100%; object-fit: cover; }
  .why-h2 { font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.1; margin-bottom: 1.5rem; }
  .why-h2 .mask-line { display: block; }
  .why-h2-emph { font-style: italic; color: var(--ochre-800); font-variation-settings: "opsz" 144; }
  .why-lead { font-family: var(--font-display); font-size: 1.3rem; color: var(--ink); line-height: 1.45; margin-bottom: 1.5rem; }
  .why-body-text { color: var(--ink-soft); line-height: 1.7; }
  @media (max-width: 900px) { .why-grid { grid-template-columns: 1fr; gap: 3rem; } }

  /* CTA */
  .cta-band { background: radial-gradient(ellipse at 30% 20%, rgba(224,168,106,0.25), transparent 60%), var(--teal-800); color: var(--shell); padding-block: var(--section-y); }
  .cta-inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: center; }
  .cta-h2 { font-size: clamp(1.75rem, 2.8vw, 2.4rem); color: var(--shell); line-height: 1.15; letter-spacing: -0.015em; margin-bottom: 0.75rem; }
  .cta-lead { color: rgba(245,239,228,0.85); font-size: 1.05rem; }
  .cta-lead .hand { color: var(--ochre-500); font-size: 1.35rem; margin-left: 0.35rem; }
  .cta-actions { display: flex; flex-direction: column; gap: 0.85rem; }
  .cta-actions .btn { justify-content: center; }
  .cta-ghost { background: transparent; color: var(--shell); border-color: rgba(245,239,228,0.5); }
  .cta-ghost:hover { background: var(--shell); color: var(--teal-900); border-color: var(--shell); }
  @media (max-width: 820px) { .cta-inner { grid-template-columns: 1fr; } }
</style>
