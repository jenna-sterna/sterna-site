---
import Layout from "../../layouts/Layout.astro";
import { path } from "../../lib/data";
import { loadExperiences, loadFeaturedExperiences } from "../../lib/experiences";
import type { Lang } from "../../lib/i18n";
import { getCompany, getPage, getReviews, pick } from "../../lib/siteData";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const home = await getPage("home");
const company = await getCompany();
const reviews = await getReviews();

const experiences = await loadExperiences();
const featuredExperiences = await loadFeaturedExperiences();

// All hero/decor photos now come from the CMS media folder (/public/uploads/).
const heroImage = "/uploads/hero/aveiro-canal-hero.jpg";
const saltPansImg = "/uploads/salt-pans/IMG_4709.jpg";
const saltPansImgB = "/uploads/salt-pans/IMG_4710.jpg";
const walkingImg = "/uploads/walking-tour/20260711_112249.jpg";
const walkingImgB = "/uploads/walking-tour/20260711_120135.jpg";
const walkingImgC = "/uploads/walking-tour/20260702_153535(1).jpg";

// map by slug for the list section
const bySlug = Object.fromEntries(experiences.map((e) => [e.slug, e]));
const saltPans = bySlug["salt-pans-lunch"];
const walking = bySlug["walking-tour"];
const mealhada = bySlug["mealhada-sparkling-wine"];
const listExperiences = ["bussaco-luso", "boat-tour", "vista-alegre"].map((s) => bySlug[s]);

const introBody = pick(home, "intro_body", lang);
const featuredAnnotation = pick(home, "featured_annotation", lang);
---

<Layout lang={lang}>
  <!-- ================= HERO ================= -->
  <section class="hero" data-parallax-scope>
    <div class="hero-media">
      <img
        src={heroImage}
        alt="A moliceiro boat gliding down an Aveiro canal, lined with colorful buildings"
        loading="eager"
        class="hero-img"
        data-parallax-y="80"
      />
      <div class="hero-scrim"></div>
    </div>

    <div class="container hero-inner">
      <div class="hero-text">
        <span class="hero-eyebrow">{pick(home, "hero_eyebrow", lang)}</span>
        <h1 class="hero-h1">
          <span class="mask-line" data-stagger-index="0"><span>{pick(home, "hero_line1", lang)}</span></span>
          <span class="mask-line" data-stagger-index="1"><span>{pick(home, "hero_line2", lang)}</span></span>
          <span class="mask-line hero-italic" data-stagger-index="2"><span>{pick(home, "hero_line3", lang)}</span></span>
        </h1>
        <p class="hero-lead reveal" data-stagger-index="3">{pick(home, "hero_lead", lang)}</p>
        <div class="hero-ctas reveal" data-stagger-index="4">
          <a href={path("/experiences/", lang)} class="btn btn-primary btn-lg">
            {pick(home, "hero_ctaPrimary", lang)}
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href={company.whatsappHref} target="_blank" rel="noopener" class="btn btn-ghost btn-lg hero-ghost">
            {pick(home, "hero_ctaSecondary", lang)}
          </a>
        </div>
      </div>
    </div>

    <div class="hero-scroll">
      <span>{pick(home, "hero_scroll", lang)}</span>
      <span class="hero-scroll-line"></span>
    </div>
  </section>

  <!-- ================= INTRO (magazine-style with drop cap, no promise band) ================= -->
  <section class="intro">
    <div class="container-narrow">
      <p class="intro-caption reveal">{pick(home, "intro_caption", lang)}</p>
      <p class="intro-body reveal">
        <span class="dropcap">{introBody.charAt(0)}</span>{introBody.slice(1)}
      </p>
      <p class="hand intro-sig reveal">{pick(home, "intro_sig", lang)}</p>
    </div>
  </section>

  <!-- ================= FEATURED #01: SALT PANS (editorial hero) ================= -->
  <section class="feature-01" data-parallax-scope>
    <span class="watermark" aria-hidden="true" data-parallax-y="30">Aveiro</span>
    <svg class="feature-glyph feature-glyph-tl" viewBox="0 0 120 120" fill="none" aria-hidden="true">
      <circle cx="60" cy="60" r="52" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 4" opacity="0.35"/>
      <circle cx="60" cy="60" r="34" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
      <circle cx="60" cy="60" r="4" fill="currentColor" opacity="0.4"/>
    </svg>
    <div class="container feature-grid">
      <div class="feature-photo-wrap">
        <div class="photo-reveal feature-photo-main">
          <img
            src={saltPansImg}
            alt="Marnoto working the salt pans"
            class="parallax-img"
            data-parallax-y="30"
            loading="lazy"
          />
        </div>
        <div class="photo-reveal feature-photo-mini">
          <img src={saltPansImgB} alt="Salt pan detail" loading="lazy" />
        </div>
        <div class="annotation reveal" aria-hidden="true">
          <span class="anno-text">{featuredAnnotation}</span>
          <svg class="anno-arrow" viewBox="0 0 80 50" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 40 C 20 30, 40 15, 74 6"/>
            <path d="M66 4 L 74 6 L 70 13"/>
          </svg>
        </div>
      </div>

      <div class="feature-body">
        <div class="section-marker">
          <span class="marker-num">{pick(home, "featured_number", lang)}</span>
          <span class="marker-line"></span>
          <span class="marker-label">{pick(home, "featured_eyebrow", lang)}</span>
        </div>
        <h2 class="feature-h2">
          <span class="mask-line"><span>{pick(home, "featured_hookLine1", lang)}</span></span>
          <span class="mask-line feature-h2-emph"><span>{pick(home, "featured_hookLine2", lang)}</span></span>
        </h2>
        <p class="feature-lead reveal">{pick(home, "featured_copyLead", lang)}</p>
        <blockquote class="feature-pullquote reveal">
          <p>&ldquo;{pick(home, "featured_pullQuote", lang)}&rdquo;</p>
        </blockquote>
        <a href={path(`/experiences/${saltPans.slug}/`, lang)} class="link-arrow reveal">
          {pick(home, "featured_cta", lang)}
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= FEATURED DUO: WALKING TOUR + MEALHADA ================= -->
  <section class="duo">
    <div class="container">
      <div class="duo-marker">
        <span class="marker-line"></span>
        <span class="marker-label">{pick(home, "duo_eyebrow", lang)}</span>
      </div>

      <div class="duo-grid" data-reveal-group>
        <!-- Walking Tour -->
        <a href={path(`/experiences/${walking.slug}/`, lang)} class="duo-item" data-stagger-index="0">
          <div class="duo-kicker">{pick(home, "duo_w1Kicker", lang)}</div>
          <div class="duo-photo photo-reveal">
            <img src={walkingImg} alt={walking.name[lang]} loading="lazy" />
          </div>
          <h3>{walking.name[lang]}</h3>
          <p>{walking.oneLiner[lang]}</p>
          <span class="duo-cta">
            {lang === "pt" ? "Ver mais" : "Read more"}
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>

        <!-- Mealhada -->
        <a href={path(`/experiences/${mealhada.slug}/`, lang)} class="duo-item duo-item-tilt" data-stagger-index="1">
          <div class="duo-kicker">{pick(home, "duo_w2Kicker", lang)}</div>
          <div class="duo-photo photo-reveal">
            <img src={mealhada.heroPhoto} alt={mealhada.name[lang]} loading="lazy" />
          </div>
          <h3>{mealhada.name[lang]}</h3>
          <p>{mealhada.oneLiner[lang]}</p>
          <span class="duo-cta">
            {lang === "pt" ? "Ver mais" : "Read more"}
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= FEATURED LIST (text-forward, no card grid) ================= -->
  <section class="list-exp">
    <div class="container list-grid">
      <div class="list-intro">
        <div class="list-marker">
          <span class="marker-line"></span>
          <span class="marker-label">{pick(home, "listExp_eyebrow", lang)}</span>
        </div>
        <p class="list-lead reveal">
          {pick(home, "listExp_leadPrefix", lang)} <em>{pick(home, "listExp_leadEmph", lang)}</em>
        </p>
      </div>

      <ul class="list-items" data-reveal-group>
        {listExperiences.map((exp, i) => (
          <li class="list-item" data-stagger-index={i}>
            <a href={path(`/experiences/${exp.slug}/`, lang)}>
              <div class="list-item-num">0{i + 4}</div>
              <div class="list-item-body">
                <h3>{exp.name[lang]}</h3>
                <p>{exp.short[lang]} · {exp.duration[lang]}</p>
              </div>
              <span class="list-item-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="list-foot reveal">
        <a href={path("/experiences/", lang)} class="btn btn-ghost">
          {pick(home, "listExp_ctaAll", lang)}
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= WHY (long-form, no bullet list) ================= -->
  <section class="why">
    <div class="container why-inner">
      <div class="why-marker">
        <span class="marker-line"></span>
        <span class="marker-label">{pick(home, "whyList_eyebrow", lang)}</span>
      </div>
      <h2 class="why-h2">
        <span class="mask-line"><span>{pick(home, "whyList_h2", lang)}</span></span>
      </h2>
      <p class="why-body reveal">{pick(home, "whyList_body", lang)}</p>
      <p class="why-ask reveal hand">{pick(home, "whyList_ask", lang)}</p>
    </div>
  </section>

  <!-- ================= REAL PROOF (real TripAdvisor reviews, verbatim) ================= -->
  <section class="proof">
    <div class="container">
      <div class="proof-head">
        <h2>
          <span class="mask-line"><span>{pick(home, "proof_h2Line1", lang)}</span></span>
          <span class="mask-line proof-h2-emph"><span>{pick(home, "proof_h2Line2", lang)}</span></span>
        </h2>
        <p class="proof-lead reveal">{pick(home, "proof_lead", lang)}</p>
      </div>

      <div class="reviews-grid" data-reveal-group>
        {reviews.slice(0, 6).map((r, i) => (
          <figure class="review-card" data-stagger-index={i}>
            <div class="review-stars" aria-label="Five stars">{"★".repeat(r.rating)}</div>
            <blockquote>{lang === "pt" ? r.quotePt : r.quoteEn}</blockquote>
            <figcaption>
              <span class="review-name">{r.authorName}</span>
              <span class="review-meta"> · {r.authorMeta}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="proof-foot reveal">
        <a href={company.tripadvisorUrl} target="_blank" rel="noopener" class="proof-cta">
          {pick(home, "proof_cta", lang)}
        </a>
      </div>
    </div>
  </section>

  <!-- ================= FOUNDERS TEASER (short, no full card grid) ================= -->
  <section class="founders-teaser">
    <div class="container founders-inner">
      <div class="founders-copy">
        <div class="section-marker">
          <span class="marker-line"></span>
          <span class="marker-label">{pick(home, "founders_eyebrow", lang)}</span>
        </div>
        <h2 class="founders-h2">
          <span class="mask-line"><span>{pick(home, "founders_h2Line1", lang)}</span></span>
          <span class="mask-line founders-h2-emph"><span>{pick(home, "founders_h2Line2", lang)}</span></span>
        </h2>
        <p class="founders-body reveal">{pick(home, "founders_body", lang)}</p>
        <a href={path("/about/", lang)} class="link-arrow reveal">
          {pick(home, "founders_ctaMore", lang)}
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="founders-photo-strip" aria-hidden="true">
        <div class="founders-mini photo-reveal"><img src={walkingImgC} alt="" loading="lazy" /></div>
        <div class="founders-mini photo-reveal founders-mini-tilt"><img src={walkingImgB} alt="" loading="lazy" /></div>
        <div class="founders-mini photo-reveal"><img src={saltPansImgB} alt="" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- ================= SINGLE CTA (kept minimal) ================= -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div class="cta-copy">
        <h2 class="cta-h2">{pick(home, "cta_h2", lang)}</h2>
        <p class="cta-lead">{pick(home, "cta_lead", lang)} <span class="hand">{pick(home, "cta_obrigado", lang)}</span></p>
      </div>
      <div class="cta-actions">
        <a href={company.whatsappHref} target="_blank" rel="noopener" class="btn btn-ochre btn-lg">
          {pick(home, "cta_whatsapp", lang)} {company.whatsapp}
        </a>
        <a href={company.emailHref} class="btn btn-ghost btn-lg cta-ghost">{pick(home, "cta_email", lang)}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(4rem, 10vh, 8rem);
    overflow: hidden;
    isolation: isolate;
    color: var(--shell);
  }
  .hero-media { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero-img, .hero-media :global(img.hero-img) { width: 100%; height: 115%; object-fit: cover; }
  .hero-scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(15,47,54,0.35) 0%, rgba(15,47,54,0.20) 15%, rgba(15,47,54,0.80) 55%, rgba(15,47,54,1) 100%),
      radial-gradient(ellipse 90% 100% at 25% 85%, rgba(15,47,54,0.88), transparent 72%);
  }
  .hero-inner { width: 100%; }
  .hero-text { max-width: 780px; }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ochre-500);
    margin-bottom: 1.5rem;
  }
  .hero-h1 { font-size: var(--text-display); color: var(--shell); line-height: 1.02; }
  .hero-h1 .mask-line { display: block; }
  .hero-italic { font-style: italic; color: var(--ochre-500); font-variation-settings: "opsz" 144; }
  .hero-lead {
    margin-top: 2rem;
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    line-height: 1.6;
    color: var(--shell);
    font-weight: 500;
    max-width: 58ch;
    text-shadow: 0 1px 3px rgba(15, 47, 54, 0.9), 0 0 24px rgba(15, 47, 54, 0.6);
  }
  .hero-h1 { text-shadow: 0 2px 8px rgba(15, 47, 54, 0.5), 0 0 32px rgba(15, 47, 54, 0.35); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .hero-ghost {
    background: rgba(245,239,228,0.08);
    color: var(--shell);
    border-color: rgba(245,239,228,0.35);
    backdrop-filter: blur(6px);
  }
  .hero-ghost:hover { background: var(--shell); color: var(--teal-900); border-color: var(--shell); }
  .hero-scroll {
    position: absolute; right: var(--gutter); bottom: 2rem;
    display: flex; align-items: center; gap: 0.75rem;
    font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: rgba(245,239,228,0.7);
  }
  .hero-scroll-line {
    width: 40px; height: 1px; background: currentColor;
    display: inline-block; position: relative; overflow: hidden;
  }
  .hero-scroll-line::after {
    content: ""; position: absolute; inset: 0;
    background: var(--ochre-500);
    animation: scrollhint 2.4s cubic-bezier(0.65,0,0.35,1) infinite;
  }
  @keyframes scrollhint {
    0% { transform: translateX(-100%); }
    60% { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }
  @media (max-width: 720px) {
    .hero { min-height: 88vh; }
    .hero-h1 { font-size: clamp(2.75rem, 12vw, 4.5rem); }
    .hero-scroll { display: none; }
    .hero-scrim {
      background:
        linear-gradient(180deg, rgba(15,47,54,0.45) 0%, rgba(15,47,54,0.50) 25%, rgba(15,47,54,0.92) 55%, rgba(15,47,54,1) 75%, rgba(15,47,54,1) 100%),
        radial-gradient(ellipse 140% 100% at 30% 85%, rgba(15,47,54,0.85), transparent 78%);
    }
    .hero-lead {
      text-shadow: 0 1px 4px rgba(15, 47, 54, 0.95), 0 0 20px rgba(15, 47, 54, 0.7);
    }
    .hero-h1 { text-shadow: 0 2px 10px rgba(15, 47, 54, 0.7), 0 0 24px rgba(15, 47, 54, 0.5); }
  }

  /* ---------- INTRO ---------- */
  .intro { padding-block: clamp(5rem, 8vw, 7rem); background: var(--shell); border-bottom: 1px solid var(--line); }
  .intro-caption {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal-700);
    margin-bottom: 2.5rem;
    text-align: center;
  }
  .intro-body {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 1.75vw, 1.6rem);
    line-height: 1.5;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .dropcap {
    float: left;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 4.5em;
    line-height: 0.9;
    padding: 0.05em 0.12em 0 0;
    color: var(--ochre-800);
    font-variation-settings: "opsz" 144;
  }
  .intro-sig {
    font-size: 1.75rem;
    text-align: center;
    margin-top: 3rem;
    color: var(--ochre-800);
  }

  /* ---------- SECTION MARKERS (replaces most eyebrows) ---------- */
  .section-marker, .duo-marker, .list-marker, .why-marker {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .marker-num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--ochre-800);
    letter-spacing: 0.02em;
  }
  .marker-line {
    display: inline-block;
    width: 48px;
    height: 1px;
    background: var(--line-strong);
  }
  .marker-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  /* ---------- FEATURE 01: SALT PANS ---------- */
  .feature-01 {
    padding-block: var(--section-y-lg);
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 90% 15%, var(--blush-100) 0%, transparent 50%),
      radial-gradient(ellipse at 10% 100%, var(--ochre-100) 0%, transparent 55%),
      var(--blush-50);
  }
  .watermark {
    position: absolute;
    top: 42%;
    left: -3vw;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(12rem, 24vw, 26rem);
    line-height: 0.85;
    color: var(--terracotta-800);
    opacity: 0.06;
    letter-spacing: -0.04em;
    pointer-events: none;
    z-index: 0;
    white-space: nowrap;
    transform: translateY(-40%);
    font-variation-settings: "opsz" 144;
  }
  .feature-glyph {
    position: absolute;
    width: 220px;
    height: 220px;
    color: var(--terracotta-700);
    pointer-events: none;
    z-index: 0;
  }
  .feature-glyph-tl {
    top: 6%;
    left: 5%;
    animation: spin-slow 60s linear infinite;
  }
  @keyframes spin-slow {
    to { transform: rotate(360deg); }
  }
  .feature-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4.5rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .feature-photo-wrap { position: relative; }
  .feature-photo-main { aspect-ratio: 4/5; }
  .feature-photo-main :global(img.parallax-img), .feature-photo-main img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .feature-photo-mini {
    position: absolute;
    right: -3rem;
    bottom: -3rem;
    width: 42%;
    aspect-ratio: 4/5;
    border: 8px solid var(--paper);
    box-shadow: var(--shadow-lift);
    transform: rotate(3deg);
  }
  .feature-photo-mini :global(img), .feature-photo-mini img { width: 100%; height: 100%; object-fit: cover; }
  .annotation {
    position: absolute;
    left: 5%;
    bottom: 6%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 210px;
    color: #fff;
    padding: 0.75rem 1rem 0.85rem;
    background: rgba(15, 47, 54, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: var(--radius);
    box-shadow: 0 10px 30px -10px rgba(15,47,54,0.5);
    transform: rotate(-2deg);
    opacity: 0;
    animation: annoIn 900ms 900ms var(--ease-out) forwards;
    z-index: 2;
  }
  @keyframes annoIn {
    from { opacity: 0; transform: rotate(-2deg) translateY(10px); }
    to { opacity: 1; transform: rotate(-2deg) translateY(0); }
  }
  .anno-arrow {
    width: 68px;
    height: 42px;
    color: var(--ochre-500);
    margin-top: 0.35rem;
    align-self: flex-end;
    transform: rotate(4deg);
  }
  .anno-text {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    color: var(--ochre-500);
    line-height: 1.15;
    text-align: left;
  }

